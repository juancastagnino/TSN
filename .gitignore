.env
.env.*
!.env.example
!.env.template

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
